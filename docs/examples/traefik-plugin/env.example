# Copy to .env and edit. Non-secret values only: the API key lives in secrets/unifi_api_key.
# Values must be single-line and must not contain | & \ " or ` (render.sh rejects them).

# UniFi controller base URL. It must already be reachable and resolvable from the Traefik container.
UNIFI_HOST=https://192.0.2.1
# Real controllers report internalReference "default" and display name "Default".
# Releases before Bollard v0.7.1 match only the display name or site UUID, so keep "Default" (or a UUID) with those releases.
UNIFI_SITE=Default
# Keep false. For a private CA, add compose.custom-ca.yaml instead of disabling verification.
UNIFI_SKIP_TLS_VERIFY=false
# Leave empty unless you use compose.custom-ca.yaml (which sets it for you).
UNIFI_CA_CERT=

# IPv4 address that clients use to reach Traefik. NOT the nginx backend and NOT the controller.
TRAEFIK_ADDRESS=192.0.2.10
# Hostname served by nginx and registered in UniFi DNS.
APP_HOST=app.home.arpa
POLL_INTERVAL=30s

# Released plugin tag loaded from the Traefik plugin catalog. Ignored by compose.local-plugin.yaml.
# x-release-please-start-version
BOLLARD_VERSION=v0.8.0
# x-release-please-end

# Host side of the published web entrypoint. Defaults are loopback-only so the tutorial is safe on a laptop.
# For real LAN clients use HTTP_BIND=0.0.0.0 and HTTP_PORT=80.
HTTP_BIND=127.0.0.1
HTTP_PORT=8000

# Optional overrides:
# TRAEFIK_IMAGE=traefik:v3.7.19
# RENDER_IMAGE=busybox:stable
# UNIFI_API_KEY_FILE=./secrets/unifi_api_key
