# Copy this file to dev/.env and fill in your values.
# dev/.env is gitignored — never commit credentials.
#
# Usage:
#   cp dev/env.example dev/.env
#   $EDITOR dev/.env
#   docker compose -f dev/docker-compose.yml up --build

UNIFI_HOST=https://unifi.home.arpa
UNIFI_API_KEY=your-api-key-here
UNIFI_SITE=default
UNIFI_SKIP_TLS_VERIFY=false
# For a private CA, mount its PEM file into the container and set UNIFI_CA_CERT
# to the container path. See docs/examples/custom-ca.yml.
# Disabling verification exposes the API key to impersonated controllers.

METRICS_ADDR=:9090
